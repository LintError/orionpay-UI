# OrionPay Environment Configuration
# Copy this file to .env.local and adjust as needed

# Stellar Horizon URL (default: testnet)
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Stellar Network (testnet | public | futurenet)
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Friendbot URL (testnet account funding)
NEXT_PUBLIC_FRIENDBOT_URL=https://friendbot.stellar.org
