# OrionPay frontend — environment configuration
#
# Copy this file to `.env.local` and adjust the values. Every variable is optional;
# unset values fall back to the public Stellar testnet.
#
# NEXT_PUBLIC_* variables are exposed to the browser bundle, so keep them to
# non-sensitive values. Do not commit real keys or secrets.
#
# Horizon API endpoint the app uses for account / fee / transaction calls.
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
#
# Friendbot endpoint used to fund a testnet account. Leave empty on a network
# that has no Friendbot.
NEXT_PUBLIC_FRIENDBOT_URL=https://friendbot.stellar.org
#
# Stellar network: `testnet` (default) or `public`/`mainnet`. Selecting a non-testnet
# network also requires a matching NEXT_PUBLIC_HORIZON_URL.
NEXT_PUBLIC_STELLAR_NETWORK=testnet
#
# Transaction settlement timeout, in seconds (default: 30).
NEXT_PUBLIC_STELLAR_TX_TIMEOUT=30
